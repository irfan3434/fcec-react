# Base URL for images and video.
#
# Empty  -> served from this app's /public folder (what Vercel deploys).
# Set    -> served from a CDN, e.g. https://fcec.b-cdn.net
#
# Content files store bare paths like `hero/fcec-hero.mp4`, which resolve
# against this. See src/lib/media.js and the README.
VITE_MEDIA_BASE_URL=
